# --- Python 產生的暫存檔 ---
__pycache__/
*.py[cod]
*$py.class
.Python

# --- 虛擬環境 ---
.venv/
venv/
env/
ENV/

# --- 環境變數與機密檔案 ---
.env
*.pem
*.key
!.env.example  # 驚嘆號代表「不要忽略」，確保範例檔能上傳方便協作

# --- Docker 與資料庫暫存 ---
.dockerignore
pg_data/

# --- 專案特定檔案 ---
uploads/       # 擋掉測試上傳的圖檔或文件

# --- Cloudflare Tunnel 機密 ---
cloudflared/credentials.json
cloudflared/config.yml

# --- 開發工具與 OS 設定 ---
.vscode/
.idea/
.DS_Store