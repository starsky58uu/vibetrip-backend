# ==========================================
# VibeTrip 後端環境變數範例
# 複製這份檔案成 .env 後填入實際值
# ==========================================

# ---------- 基本 ----------
DEBUG=true
# CORS 允許來源（逗號分隔）；開發可用 *，正式環境請填實際網域
CORS_ORIGINS=*

# ---------- PostgreSQL ----------
DB_USER=tdx_user
DB_PASSWORD=change-this-password
DB_NAME=tdx_database

# ---------- JWT ----------
# 正式環境務必換成長隨機字串: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- 外部 API ----------
# TDX: https://tdx.transportdata.tw (交通部平台，免費申請)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# OpenWeatherMap: https://openweathermap.org/api (免費 tier 夠用)
OPENWEATHER_API_KEY=

# Google Maps Platform: https://console.cloud.google.com (須啟用 Places / Directions API)
GOOGLE_MAPS_API_KEY=

# Groq: https://console.groq.com (AI 行程生成，LLaMA 3.3，免費額度大)
GROQ_API_KEY=

# ---------- Cloudflare Tunnel（可選，見 docs/CLOUDFLARE_TUNNEL.md）----------
# Zero Trust → Networks → Tunnels → 建立 tunnel 後複製的 Docker token
CLOUDFLARE_TUNNEL_TOKEN=

# 經 tunnel 對外時，上傳圖片的公開 URL 前綴（例：https://api.yourdomain.com/static/uploads）
PUBLIC_CDN_BASE=http://localhost:8000/static/uploads
