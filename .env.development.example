# 本機開發覆寫 — 複製成 .env.development（勿提交 git）
# prod 的 .env 仍保留 DEBUG=false、tunnel token 等；此檔只覆寫開發需要的欄位
#
# Docker dev API：docker compose ... -f docker-compose.dev-api.yml --profile dev up api-dev
# 本機 uvicorn：先確保 prod stack 的 db/redis 有跑，再：
#   uvicorn app.main:app --reload --port 8001 --proxy-headers

DEBUG=true
CORS_ORIGINS=*

# 與 prod 不同 secret 即可；dev 不必與 prod JWT 相同
JWT_SECRET_KEY=dev-local-only-not-for-production

# 本機直跑 uvicorn 時用 localhost；Docker api-dev 會被 compose 覆寫成 db/redis
DB_HOST=localhost
REDIS_HOST=localhost

UPLOAD_DIR=./uploads
PUBLIC_CDN_BASE=http://localhost:8001/static/uploads

# 開發時可關限流，方便反覆測試
RATE_LIMIT_ENABLED=false
